ANTHROPIC_API_KEY=your-api-key-here

# LangSmith tracing (optional; leave unset to disable tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=auto-apply-agent

# Optional, used by linkedin_tool.py / run_linkedin_lab.py only if your
# account logs in with a password (not e.g. "Continue with Google"). Leave
# unset and you'll be prompted to log in by hand in the browser window once;
# the session is then reused on later runs either way.
LINKEDIN_EMAIL=your-linkedin-email@example.com
LINKEDIN_PASSWORD=your-linkedin-password
